<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      One theme family, following the system.

      Dark mode DID work before this: values-night redefined MainTheme with a dark
      Material parent. The cost was two full theme definitions to keep in step, each
      with its own hardcoded accent (#1a73e9 light, #64b5f6 night), while SettingsTheme
      inherited DeviceDefault — so the launcher screen was framework Material and the
      settings screen was the OEM's Settings style, two design languages one tap apart.

      Both now inherit DeviceDefault, which follows the system light/dark setting on its
      own and matches the Settings surfaces this sits beside. That leaves only colours
      to vary, so values-night carries the night accent and values-v31 the wallpaper
      palette (Material You), instead of duplicated styles.
    -->
    <style name="MainTheme" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:colorAccent">@color/nex_accent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Insets are applied in code (WindowInsets) rather than by this flag: the
             app targets SDK 37, where edge-to-edge is enforced and fitsSystemWindows
             alone leaves content under the bars. -->
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>

    <style name="ListDividerNull">
        <item name="android:listDivider">@null</item>
    </style>

    <style name="SettingsTheme" parent="android:Theme.DeviceDefault.Settings">
        <item name="android:singleLineTitle">false</item>
        <item name="android:listDivider">@null</item>
        <item name="android:colorAccent">@color/nex_accent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>

</resources>
