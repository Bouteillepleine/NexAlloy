<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Material 3, DayNight, dynamic colour.

      The module UI was built on the framework android.preference stack and framework
      Material themes, both frozen since 2019. That is what made it look dated: fixed
      row metrics, a hardcoded accent, and no way to reach Material 3. It now runs on
      AndroidX Preference under Theme.Material3.DayNight, which follows the system
      light/dark setting and, from Android 12, the wallpaper palette.

      preferenceTheme is what styles the AndroidX preference rows; without it they fall
      back to unstyled defaults.
    -->
    <style name="MainTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="preferenceTheme">@style/Preference.NexAlloy</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- The settings screens use the same theme; the old SettingsTheme inherited
         DeviceDefault.Settings, a different design language one tap away from MainTheme. -->
    <style name="SettingsTheme" parent="MainTheme" />

    <style name="Preference.NexAlloy" parent="@style/PreferenceThemeOverlay">
        <item name="preferenceCategoryTitleTextAppearance">
            @style/TextAppearance.Material3.TitleSmall
        </item>
        <item name="preferenceCategoryTitleTextColor">?attr/colorPrimary</item>
    </style>

    <style name="ListDividerNull">
        <item name="android:listDivider">@null</item>
    </style>

</resources>
