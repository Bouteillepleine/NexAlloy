<?xml version="1.0" encoding="utf-8"?>
<!-- Static guidance text.

     These captions used to be Preference rows with isEnabled=false, which renders
     them at disabled opacity — so the text most worth reading was the least legible
     on the screen, and talkback announced it as an unavailable control. This is a
     plain TextView at full contrast, not focusable, not a control. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/caption_text"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:textAppearance="?android:attr/textAppearanceSmall"
    android:textColor="?android:attr/textColorSecondary"
    android:focusable="false"
    android:clickable="false" />
