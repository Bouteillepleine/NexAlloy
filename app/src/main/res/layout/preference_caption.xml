<?xml version="1.0" encoding="utf-8"?>
<!--
  Static guidance text.

  These captions used to be Preference rows with isEnabled=false, which renders them
  at disabled opacity, so the text most worth reading was the least legible and
  talkback announced it as an unavailable control. This is a plain TextView instead.

  Colours come from the MATERIAL attrs, not the android: ones. Under
  Theme.Material3.DayNight, ?android:attr/textColorSecondary does not resolve to a
  legible colour on the M3 dark surface: the row bound and took up its full height
  while the text itself was invisible, which read as a mysterious blank gap in the
  middle of the list.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/caption_text"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="?attr/listPreferredItemPaddingStart"
    android:paddingEnd="?attr/listPreferredItemPaddingEnd"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
    android:textColor="?attr/colorOnSurfaceVariant"
    android:focusable="false"
    android:clickable="false" />
