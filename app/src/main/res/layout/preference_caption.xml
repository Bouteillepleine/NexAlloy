<?xml version="1.0" encoding="utf-8"?>
<!--
  Static guidance text.

  Captions used to be Preference rows with isEnabled=false, which renders them at
  disabled opacity, so the text most worth reading was the least legible.

  The colour is an explicit resource, NOT a theme attribute. Preference rows are
  inflated with the context carrying PreferenceThemeOverlay, which is not a Material 3
  theme: ?attr/colorOnSurfaceVariant (and ?android:attr/textColorSecondary before it)
  failed to resolve there, so the row bound at full height with invisible text — a
  mysterious blank gap in the middle of the list. values-night supplies the dark variant.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/caption_text"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:textSize="14sp"
    android:textColor="@color/nex_caption"
    android:focusable="false"
    android:clickable="false" />
