<?xml version="1.0" encoding="utf-8"?>
<!-- A fragment container is all this needs; it used to be wrapped in a LinearLayout
     whose only child was this view. Insets are applied in code, not by
     fitsSystemWindows, because the app targets an SDK where edge-to-edge is enforced. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />
